---
// The DayStrips demo, filled the way a page fills it: at runtime, from data. Synthetic.
import DayStrips from '@n1kname/components/DayStrips.astro';
import Legend from '@n1kname/components/Legend.astro';

const STATES = {
  ok: { label: 'complete', mark: 'fill', color: 'var(--c-state-complete)' },
  known: { label: 'known gap', mark: 'stripes', color: 'var(--c-state-set-aside)', gap: true },
  gap: { label: 'gap, not written down', mark: 'fill', color: 'var(--c-state-missing)', gap: true },
  late: { label: 'waiting for late data', mark: 'fill', color: 'var(--c-state-waiting)' },
  later: { label: 'not recorded yet', mark: 'empty' },
};
---

<div class="not-content">
  <Legend keys={Object.values(STATES).map(({ label, mark, color }) => ({ label, mark, color }))} />
  <DayStrips id="demo-strips" rows={3} style="margin-top: var(--sp-4)" data-states={JSON.stringify(STATES)} />
</div>

<script>
  import { setDayStrips } from '@n1kname/components/daystrips.js';

  const box = document.getElementById('demo-strips');
  const states = JSON.parse(box.dataset.states);
  const DAYS = 640;
  const stream = (label, start, gaps, known) => {
    const days = Array.from({ length: DAYS }, (_, i) => (i < start ? 'later' : 'ok'));
    for (const g of gaps) days[g] = 'gap';
    for (const [a, b] of known) for (let i = a; i <= b; i++) days[i] = 'known';
    for (let i = DAYS - 4; i < DAYS; i++) days[i] = 'late';
    const count = (s) => days.filter((d) => d === s).length;
    return { label, days, summary: `${label}: ${count('gap')} days with a gap not written down, ${count('known')} known` };
  };
  setDayStrips(box, {
    from: '2024-01-01',
    states,
    quiet: 'ok',
    quietText: 'Everything complete',
    streams: [stream('Alder', 0, [210], [[400, 430]]), stream('Birch', 120, [], [[300, 305]]), stream('Cedar', 380, [500, 501], [])],
  });
</script>
