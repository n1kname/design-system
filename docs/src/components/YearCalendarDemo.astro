---
// The YearCalendar demo, filled the way a page fills it: at runtime, from data. Synthetic: a
// seeded random year of rides, runs and swims, nobody's real days.
import RampLegend from '@n1kname/components/RampLegend.astro';
import YearCalendar from '@n1kname/components/YearCalendar.astro';

const SPORTS = [
  { key: 'run', label: 'Running', tone: 'var(--c-chart-6)' },
  { key: 'swim', label: 'Swimming', tone: 'var(--c-chart-2)' },
];
---

<div class="not-content yc-demo">
  <section class="chart-panel">
    <h3 class="yc-title">Rides in 2026 <span id="yc-ride-sum"></span></h3>
    <YearCalendar id="yc-rides" year={2026} label="Rides in 2026" />
    <RampLegend label="Kilometres a day" low="Fewer" high="More" steps class="yc-legend" />
  </section>

  <section class="chart-panel">
    {
      SPORTS.map((s) => (
        <div class="yc-sport" style={`--sport: ${s.tone}`}>
          <h3 class="yc-title">
            <i class="dot" aria-hidden="true" />
            <span class="name">{s.label}</span> <span class="sum" id={`yc-${s.key}-sum`} />
          </h3>
          <YearCalendar id={`yc-${s.key}`} year={2026} tone={s.tone} levels={s.key === 'swim' ? 1 : 4} label={`${s.label} in 2026`} />
        </div>
      ))
    }
  </section>
</div>

<script>
  import { setYearCalendar } from '@n1kname/components/yearcalendar.js';

  // A small seeded generator, so the demo is the same on every load.
  let seed = 20261110;
  const rand = () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const TODAY = '2026-11-10';
  const year = (fn) => {
    const days = {};
    for (let t = Date.UTC(2026, 0, 1); ; t += 86_400_000) {
      const d = new Date(t).toISOString().slice(0, 10);
      if (d > TODAY) break;
      const v = fn(new Date(t).getUTCDay(), Number(d.slice(5, 7)), d);
      if (v) days[d] = v;
    }
    return days;
  };
  const fmt = (n, digits = 0) => n.toLocaleString('en', { maximumFractionDigits: digits, minimumFractionDigits: digits });

  // Rides: most weekdays a short one, longer at weekends and in summer, none in two weeks of August.
  const rides = year((wd, m, d) => {
    if (d >= '2026-08-03' && d <= '2026-08-16') return 0;
    const weekend = wd === 0 || wd === 6;
    if (rand() < (weekend ? 0.25 : 0.35)) return 0;
    const summer = m >= 5 && m <= 9 ? 1.4 : 1;
    return Math.round((weekend ? 20 + rand() * 60 : 4 + rand() * 14) * summer * 10) / 10;
  });
  const total = Object.values(rides).reduce((a, b) => a + b, 0);
  document.getElementById('yc-ride-sum')!.textContent = `· ${Object.keys(rides).length} days · ${fmt(total)} km`;
  setYearCalendar(document.getElementById('yc-rides')!, {
    year: 2026,
    days: rides,
    today: TODAY,
    label: `Rides in 2026: ${Object.keys(rides).length} days, ${fmt(total)} km`,
    format: (km) => `${fmt(km, 1)} km`,
    empty: 'No ride',
    total: (km) => `${fmt(km)} km`,
    words: { days: 'Days with a ride', total: 'Kilometres' },
  });

  // Runs and swims: a count and kilometres a day. Runs coloured by distance in four strengths of
  // one tone; swims in the tone alone, a day with one or not.
  const sports = {
    run: { label: 'Running', days: year((wd) => (rand() < ([2, 4, 0].includes(wd) ? 0.55 : 0.06) ? { count: rand() < 0.1 ? 2 : 1, km: Math.round((5 + rand() * 9) * 10) / 10 } : 0)) },
    swim: { label: 'Swimming', days: year((wd, m) => (wd === 6 && rand() < (m >= 6 && m <= 8 ? 0.9 : 0.5) ? { count: 1, km: Math.round((1 + rand() * 1.5) * 10) / 10 } : 0)) },
  };
  for (const [key, s] of Object.entries(sports)) {
    const entries = Object.values(s.days);
    const sessions = entries.reduce((n, d) => n + d.count, 0);
    const km = entries.reduce((n, d) => n + d.km, 0);
    const sum = `${sessions} sessions across ${entries.length} days · ${fmt(km)} km`;
    document.getElementById(`yc-${key}-sum`)!.textContent = `· ${sum}`;
    setYearCalendar(document.getElementById(`yc-${key}`)!, {
      year: 2026,
      days: s.days,
      today: TODAY,
      value: (d) => (key === 'run' ? d.km : d.count),
      tone: `var(--c-chart-${key === 'run' ? 6 : 2})`,
      levels: key === 'run' ? 4 : 1,
      label: `${s.label} in 2026: ${sum}`,
      format: (d) => `${s.label.toLowerCase()} · ${d.count} time${d.count === 1 ? '' : 's'}, ${fmt(d.km, 1)} km`,
      total: (n) => `${n} sessions`,
      words: { days: 'Days', total: 'Sessions' },
    });
  }
</script>

<style>
  .yc-demo {
    display: grid;
    gap: var(--sp-4);
  }

  .yc-demo .chart-panel {
    margin: 0;
    overflow: visible;
  }

  .yc-demo .yc-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
    margin: 0 0 var(--sp-2);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: normal;
    color: var(--c-text);
  }

  .yc-title span:not(.name) {
    font-weight: 400;
    color: var(--c-text-muted);
  }

  .yc-sport + .yc-sport {
    margin-top: var(--sp-5);
  }

  .yc-sport .name {
    color: color-mix(in oklab, var(--sport) 70%, var(--c-text));
  }

  .yc-sport .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sport);
  }

  .yc-demo :global(.yc-legend) {
    margin-top: var(--sp-3);
  }
</style>
