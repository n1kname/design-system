---
/**
 * Hexagons coloured by the heat ramp, by each count's rank, and raised in 3D by log(count); the
 * legend floats at the bottom left, and a card says each cell's count under the pointer.
 * Synthetic counts on a plain ground.
 */
import FloatPanel from '@n1kname/components/FloatPanel.astro';
import MapStage from '@n1kname/components/MapStage.astro';
import RampLegend from '@n1kname/components/RampLegend.astro';
import Segmented from '@n1kname/components/Segmented.astro';
---

<div class="not-content" style="--map-stage-height: 32rem">
  <MapStage id="heat-demo-map" label="Fictional counts in hexagons on a plain grid" loading="Counting…" failed="This map needs WebGL, which this browser has turned off.">
    <FloatPanel place="top-left" layout="row" label="Map controls">
      <Segmented id="heat-demo-view" label="View" value="2d" options={[{ value: '2d', label: '2D' }, { value: '3d', label: '3D' }]} />
    </FloatPanel>
    <FloatPanel place="bottom-left">
      <RampLegend id="heat-demo-legend" label="Visits" />
    </FloatPanel>
  </MapStage>
</div>

<script>
  import { hexbin, hexFeatures } from '@n1kname/charts/hexbin';
  import { hexLayers } from '@n1kname/components/hexmap.js';
  import { room, setStage } from '@n1kname/components/mapstage.js';
  import { bounds, groundMap, maplibregl, points } from '../lib/map-demo.js';

  const box = document.getElementById('heat-demo-map')!;
  // 150 m hexagons from a grid fixed at 0° 0°, so they don't move if the points change.
  const data = hexFeatures(hexbin(points(), { size: 150, origin: [0, 0] }));

  const map = groundMap(box, { canvasContextAttributes: { antialias: true } });
  if (map) {
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
    const hexes = hexLayers(map, {
      tall: 1600,
      opacity: ({ tall }) => (tall ? 0.8 : 0.6),
      Popup: maplibregl.Popup,
      card: (p) => `<strong>${p.count}</strong> visits`,
    });
    map.on('load', () => {
      hexes.setData(data);
      map.fitBounds(bounds(data), { padding: room(box), duration: 0 });
      box.closest('.not-content')!.querySelector<HTMLElement>('[data-ramp-note]')!.textContent = ` · ${data.features.length} hexagons`;
      setStage(box, 'ready');
    });
    document.getElementById('heat-demo-view')!.addEventListener('segment-change', (e) => hexes.setTall((e as CustomEvent).detail.value === '3d'));
  } else setStage(box, 'failed');
</script>
