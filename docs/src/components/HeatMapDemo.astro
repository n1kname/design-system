---
/**
 * Hexagons coloured by the heat ramp, by each count's rank, and raised in 3D by log(count); the
 * legend floats at the bottom left, and a card says each cell's count under the pointer.
 * Synthetic counts on a plain ground.
 */
import FloatPanel from '@n1kname/components/FloatPanel.astro';
import MapStage from '@n1kname/components/MapStage.astro';
import RampLegend from '@n1kname/components/RampLegend.astro';
import Segmented from '@n1kname/components/Segmented.astro';
---

<div class="not-content" style="--map-stage-height: 32rem">
  <MapStage id="heat-demo-map" label="Fictional counts in hexagons on a plain grid" loading="Counting…" failed="This map needs WebGL, which this browser has turned off.">
    <FloatPanel place="top-left" layout="row" label="Map controls">
      <Segmented id="heat-demo-view" label="View" value="2d" options={[{ value: '2d', label: '2D' }, { value: '3d', label: '3D' }]} />
    </FloatPanel>
    <FloatPanel place="bottom-left">
      <RampLegend id="heat-demo-legend" label="Visits" />
    </FloatPanel>
  </MapStage>
</div>

<script>
  import { ramp, room, setStage } from '@n1kname/components/mapstage.js';
  import { bounds, cells, groundMap, maplibregl, reduced } from '../lib/map-demo.js';

  const box = document.getElementById('heat-demo-map')!;
  const data = cells();
  const TALL_M = 1600;
  let tall = false;
  // Half when flat, more when raised, as the dashboard has it.
  const opacity = () => (tall ? 0.8 : 0.6);

  const map = groundMap(box, {
    canvasContextAttributes: { antialias: true },
    layers: (m) => {
      m.addSource('cells', { type: 'geojson', data });
      m.addLayer({ id: 'flat', type: 'fill', source: 'cells', paint: { 'fill-color': ramp('rank'), 'fill-opacity': opacity() } });
      m.addLayer({
        id: 'tall',
        type: 'fill-extrusion',
        source: 'cells',
        layout: { visibility: 'none' },
        paint: { 'fill-extrusion-color': ramp('rank'), 'fill-extrusion-opacity': opacity(), 'fill-extrusion-height': ['*', ['get', 'height'], TALL_M] },
      });
      m.fitBounds(bounds(data), { padding: room(box), duration: 0 });
      box.closest('.not-content')!.querySelector<HTMLElement>('[data-ramp-note]')!.textContent = ` · ${data.features.length} cells`;
      setStage(box, 'ready');
    },
    repaint: (m) => {
      m.setPaintProperty('flat', 'fill-color', ramp('rank'));
      m.setPaintProperty('tall', 'fill-extrusion-color', ramp('rank'));
    },
  });

  if (map) {
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'top-right');
    const popup = new maplibregl.Popup({ closeButton: false, closeOnClick: false, offset: 12, className: 'place-card' });
    for (const id of ['flat', 'tall']) {
      map.on('mousemove', id, (e) => {
        map.getCanvas().style.cursor = 'pointer';
        const n = e.features![0].properties.count;
        popup.setLngLat(e.lngLat).setHTML(`<div class="chart-pointer-card"><p class="chart-pointer-one"><strong>${n}</strong> visits</p></div>`).addTo(map);
      });
      map.on('mouseleave', id, () => {
        map.getCanvas().style.cursor = '';
        popup.remove();
      });
    }
    document.getElementById('heat-demo-view')!.addEventListener('segment-change', (e) => {
      tall = (e as CustomEvent).detail.value === '3d';
      map.setLayoutProperty('tall', 'visibility', tall ? 'visible' : 'none');
      map.setLayoutProperty('flat', 'visibility', tall ? 'none' : 'visible');
      map.setPaintProperty('flat', 'fill-opacity', opacity());
      map.setPaintProperty('tall', 'fill-extrusion-opacity', opacity());
      map.easeTo({ pitch: tall ? 55 : 0, bearing: tall ? -15 : 0, duration: reduced() ? 0 : 600 });
    });
  } else setStage(box, 'failed');
</script>
