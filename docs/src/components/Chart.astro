---
/** A chart string in a panel. `alt` speaks for the SVG, and the slot holds its legend or scale. */
interface Props {
  svg: string;
  alt: string;
}
const { svg, alt } = Astro.props;
---

<div class="chart-panel not-content">
  <slot name="before" />
  <div role="img" aria-label={alt} set:html={svg} />
  <slot />
</div>
