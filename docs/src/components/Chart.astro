---
/**
 * A chart in a panel, drawn twice and shown by the width of the column, so its text
 * stays readable on a phone. `alt` speaks for the SVG, the slot holds its legend or scale.
 */
interface Props {
  chart: { wide: string; narrow: string };
  alt: string;
}
const { chart, alt } = Astro.props;
---

<div class="chart-panel not-content">
  <slot name="before" />
  <div role="img" aria-label={alt}>
    <div class="wide" set:html={chart.wide} />
    <div class="narrow" set:html={chart.narrow} />
  </div>
  <slot />
</div>

<style>
  .chart-panel {
    container-type: inline-size;
  }

  .narrow {
    display: none;
    max-width: 440px;
  }

  @container (max-width: 560px) {
    .wide {
      display: none;
    }

    .narrow {
      display: block;
    }
  }
</style>
