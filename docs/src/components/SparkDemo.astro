---
// Sparklines in figure cards, drawn at build time. Synthetic figures, nobody's real ones.
import { sparkline } from '@n1kname/charts/spark';
import '@n1kname/charts/spark.css';

const CARDS = [
  { label: 'Daily steps', value: '9,840', note: 'Benchmark 8,500', tone: 'var(--c-status-good)', kind: 'bar', reference: 8500, values: [8200, 9100, 7600, 10400, 9900, 8700, 11200, 9400, 10100, 8800, 9600, 10300] },
  { label: 'Sleep', value: '6.9 h', note: 'Benchmark 7.1 h', tone: 'var(--c-status-warning)', kind: 'line', zero: false, reference: 7.1, values: [7.3, 7.0, 6.8, 7.2, 6.6, 6.9, 7.1, 6.5, 6.8, 7.0, 6.7, 6.9] },
  { label: 'Workouts a week', value: '4.2 h', note: 'Benchmark 3.5 h', tone: 'var(--c-chart-4)', kind: 'area', reference: 3.5, values: [2.8, 3.1, 3.6, 4.4, 3.9, 4.1, 4.8, 3.7, 4.0, 4.5, 4.3, 4.2], last: true },
  { label: 'Ride speed', value: '23.4 km/h', note: 'Six years', tone: 'var(--c-chart-neutral)', kind: 'bar', values: [20.1, 21.4, 22.0, null, 22.9, 23.4] },
];
---

<div class="not-content">
  <ul class="spark-demo">
    {
      CARDS.map((c) => (
        <li style={`--tone: ${c.tone}`}>
          <div class="head">
            <p class="label">{c.label}</p>
            <Fragment set:html={sparkline(c.values, { kind: c.kind, reference: c.reference, last: c.last, zero: c.zero })} />
          </div>
          <p class="value">{c.value}</p>
          <p class="note">{c.note}</p>
        </li>
      ))
    }
  </ul>
  <p class="spark-kinds">
    {
      ['bar', 'line', 'area'].map((kind) => (
        <span>
          <Fragment set:html={sparkline([3, 5, 4, 6, 5, 7, 6, 8], { kind, reference: 5, width: 96, height: 32, label: `A ${kind} sparkline of eight values, rising` })} />
          <code>{kind}</code>
        </span>
      ))
    }
  </p>
</div>

<style>
  .spark-demo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--sp-3);
  }

  .spark-demo li {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-3);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
  }

  .spark-demo p {
    margin: 0;
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .label {
    font-size: var(--text-caption);
    color: var(--c-text-secondary);
  }

  .head :global(.spark) {
    margin: -4px -4px 0 0;
  }

  .value {
    font-size: var(--text-h4, 1.25rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-text);
  }

  .note {
    font-size: var(--text-caption);
    color: var(--c-text-muted);
  }

  .spark-kinds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    margin: var(--sp-4) 0 0;
  }

  .spark-kinds span {
    display: grid;
    gap: var(--sp-1);
    justify-items: start;
    font-size: var(--text-caption);
    color: var(--c-text-muted);
  }
</style>
