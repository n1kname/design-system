{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "version": "2025.10",
  "sets": {
    "foundation": {
      "sources": [
        {
          "$ref": "primitive.tokens.json"
        },
        {
          "$ref": "scale.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "default": "light",
      "contexts": {
        "light": [
          {
            "$ref": "light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "dark.tokens.json"
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/foundation"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}
