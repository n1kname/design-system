---
/**
 * A design process as diamonds: each phase opens out (diverge) and narrows again (converge), with
 * the moments between them as stops at the diamonds' points, such as kick-off and launch. A last phase can
 * repeat instead, as smaller diamonds that fade out, for the work that goes on after launch.
 *
 * Drawn in the diagrams' own style, on a sunken plate: tinted fills with a hairline edge and soft
 * corners, as in Flow diagram, so it sits beside them. HTML and SVG, so the words are text: they wrap, scale with
 * the page, and are read out in order (moment, phase, its two halves, its name, its notes). Below
 * 560px wide the phases stack.
 *
 * Once, as it comes into view, the parts arrive left to right. Nothing moves under reduced
 * motion, and without script it is simply there.
 */
type Tone = 'cool' | 'accent' | 'quiet';

interface Half {
  /** Inside the half, such as "Discover". */
  label: string;
  /** Under the phase's name: a short title ("Diverge") and the question this half asks. */
  note?: { title: string; text: string };
}

interface Phase {
  /** Under the diamond, such as "Discovery". */
  name: string;
  /** Under the name, such as "Design the right thing". */
  motto?: string;
  tone?: Tone;
  /** The two halves: opening out, then narrowing. Leave out with `repeat`. */
  halves?: [Half, Half];
  /** Smaller diamonds that fade out, for work that keeps going. */
  repeat?: boolean;
  /** Under a repeating phase's name, as a half's note is under a diamond. */
  note?: { title: string; text: string };
}

interface Props {
  /** What the diagram is, for a screen reader: the list is named by it. */
  title: string;
  phases: Phase[];
  /** The moment before each phase, in order: "Kick off", "Plan", "Launch". */
  milestones?: (string | undefined)[];
  caption?: string;
  class?: string;
}

const { title, phases, milestones = [], caption, class: className } = Astro.props;
const tones: Tone[] = ['cool', 'accent', 'quiet'];
const items = phases.flatMap((p, i) => {
  const tone = p.tone ?? (p.repeat ? 'quiet' : tones[i % tones.length]);
  return [...(milestones[i] ? [{ kind: 'moment' as const, label: milestones[i]!, tone }] : []), { kind: 'phase' as const, phase: p, tone }];
});
// A diamond with soft corners: rounder at top and bottom, a little at the points. Drawn on a fixed
// viewBox the shape keeps, so the corners never stretch.
const rounded = (pts: [number, number][], radii: number[]) =>
  pts
    .map((p, i) => {
      const prev = pts[(i + pts.length - 1) % pts.length];
      const next = pts[(i + 1) % pts.length];
      const cut = (to: [number, number]) => {
        const [dx, dy] = [to[0] - p[0], to[1] - p[1]];
        const len = Math.hypot(dx, dy);
        return [p[0] + (dx / len) * radii[i], p[1] + (dy / len) * radii[i]].map((v) => +v.toFixed(2));
      };
      const [a, b] = [cut(prev), cut(next)];
      return `${i ? 'L' : 'M'}${a[0]} ${a[1]} Q${p[0]} ${p[1]} ${b[0]} ${b[1]}`;
    })
    .join(' ') + ' Z';
const big = rounded([[1, 60], [100, 1], [199, 60], [100, 119]], [5, 16, 5, 16]);
const small = (x: number) => rounded([[x + 4, 50], [x + 50, 18], [x + 96, 50], [x + 50, 82]], [3, 9, 3, 9]);
let hash = 0;
for (const c of title) hash = (hash * 31 + c.charCodeAt(0)) | 0;
const uid = `dia-${(hash >>> 0).toString(36)}`;
const columns = items.map((it) => (it.kind === 'moment' ? 'auto' : it.phase.repeat ? 'minmax(0, 0.75fr)' : 'minmax(0, 1fr)')).join(' ');
---

<figure class:list={['diamonds', className]} data-diamonds>
  <div class="plate">
    <ol class="row" aria-label={title} style={`--cols: ${columns}`}>
      {
        items.map((it, i) =>
          it.kind === 'moment' ? (
            <li class="moment" data-tone={it.tone} style={`--i: ${i}`}>
              <span class="stop-cell">
                <span class="stop" aria-hidden="true" />
                <span class="moment-label">{it.label}</span>
              </span>
            </li>
          ) : (
            <li class:list={['phase', { repeat: it.phase.repeat }]} data-tone={it.tone} style={`--i: ${i}`}>
              <div class="shape">
                {it.phase.repeat ? (
                  <svg viewBox="0 0 300 100" aria-hidden="true">
                    {[0, 1, 2].map((k) => (
                      <g opacity={[1, 0.6, 0.32][k]}>
                        <clipPath id={`${uid}-${i}-${k}`}>
                          <path d={small(k * 100)} />
                        </clipPath>
                        <g clip-path={`url(#${uid}-${i}-${k})`}>
                          <rect class="open" x={k * 100} y="0" width="50" height="100" />
                          <rect class="close" x={k * 100 + 50} y="0" width="50" height="100" />
                        </g>
                        <path class="edge" d={small(k * 100)} vector-effect="non-scaling-stroke" />
                      </g>
                    ))}
                  </svg>
                ) : (
                  <>
                    <svg viewBox="0 0 200 120" aria-hidden="true">
                      <clipPath id={`${uid}-${i}`}>
                        <path d={big} />
                      </clipPath>
                      <g clip-path={`url(#${uid}-${i})`}>
                        <rect class="open" x="0" y="0" width="100" height="120" />
                        <rect class="close" x="100" y="0" width="100" height="120" />
                        <line class="split" x1="100" y1="0" x2="100" y2="120" vector-effect="non-scaling-stroke" />
                      </g>
                      <path class="edge" d={big} vector-effect="non-scaling-stroke" />
                    </svg>
                    <p class="halves">
                      {it.phase.halves?.map((h) => (
                        <span>{h.label}</span>
                      ))}
                    </p>
                  </>
                )}
              </div>
              <p class="name">
                {it.phase.name}
                {it.phase.motto && <span class="motto">{it.phase.motto}</span>}
              </p>
              <div class:list={['notes', { one: it.phase.repeat }]}>
                {it.phase.repeat
                  ? it.phase.note && (
                      <p class="note">
                        <strong>{it.phase.note.title}</strong> {it.phase.note.text}
                      </p>
                    )
                  : it.phase.halves?.map(
                      (h) =>
                        h.note && (
                          <p class="note">
                            <strong>{h.note.title}</strong> {h.note.text}
                          </p>
                        ),
                    )}
              </div>
            </li>
          ),
        )
      }
    </ol>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script is:inline>
  // Before the first paint, so parts waiting to arrive never show and then vanish.
  (() => {
    const all = document.querySelectorAll('[data-diamonds]:not(.arrive):not(.seen)');
    const fig = all[all.length - 1];
    if (fig && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) fig.classList.add('arrive');
  })();
</script>

<style>
  .diamonds {
    min-width: 0;
    margin: 0;
  }

  .plate {
    container-type: inline-size;
    background: var(--c-surface-sunken);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--sp-6) var(--sp-5) var(--sp-5);
  }

  /* The diagrams' tones: a tint and an edge, never a saturated slab. The opening half carries a
   * little more of the tone than the narrowing one. */
  [data-tone='cool'] {
    --edge: color-mix(in oklab, var(--c-tag-cool-text) 55%, transparent);
    --soft: var(--c-tag-cool-bg);
    --mark: var(--c-tag-cool-text);
  }

  [data-tone='accent'] {
    --edge: var(--c-accent-edge);
    --soft: var(--c-surface-tint);
    --mark: var(--c-accent);
  }

  [data-tone='quiet'] {
    --edge: var(--c-diagram-edge);
    --soft: var(--c-surface);
    --mark: var(--c-diagram-edge);
  }

  .row {
    display: grid;
    grid-template-columns: var(--cols);
    grid-template-rows: auto auto auto;
    column-gap: var(--sp-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row > li {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    min-width: 0;
  }

  /* A moment: a stop level with the diamonds' points, its name just under it. */
  .stop-cell {
    position: relative;
    grid-row: 1;
    display: grid;
    place-items: center;
  }

  .stop {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c-surface);
    border: 2px solid var(--mark);
  }

  .moment-label {
    position: absolute;
    top: calc(50% + 16px);
    font-size: 13px;
    font-weight: 600;
    color: var(--c-text-muted);
    white-space: nowrap;
  }

  .shape {
    grid-row: 1;
    align-self: center;
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 3;
  }

  .repeat .shape {
    aspect-ratio: 3 / 1;
  }

  .shape svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The opening half: its tint with a little of its edge colour in it, in either theme. */
  .open {
    fill: color-mix(in oklab, var(--soft), var(--mark) 20%);
  }

  .close {
    fill: var(--soft);
  }

  .edge,
  .split {
    fill: none;
    stroke: var(--edge);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .split {
    stroke-width: 1;
    opacity: 0.6;
  }

  .repeat .edge {
    stroke-dasharray: 3 4;
  }

  /* Each label centred on its half's own middle, a third of the way in from its point, at one
   * size wherever the diamond is drawn. */
  .halves {
    position: absolute;
    inset: 0;
    margin: 0;
    color: var(--c-text);
    font-weight: 600;
    font-size: var(--text-body-sm);
    line-height: 1.25;
    text-align: center;
  }

  .halves span {
    position: absolute;
    top: 50%;
    width: 30%;
    translate: -50% -50%;
    text-wrap: balance;
  }

  .halves span:first-child {
    left: 34%;
  }

  .halves span:last-child {
    left: 66%;
  }

  .name {
    grid-row: 2;
    margin: var(--sp-4) 0 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sub);
    line-height: var(--leading-sub);
    color: var(--c-text);
  }

  .motto {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-caption);
    color: var(--c-text-muted);
  }

  .notes {
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: start;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--c-border);
  }

  .notes.one {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .note {
    margin: 0;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--c-text-muted);
    text-wrap: pretty;
  }

  .note strong {
    display: block;
    font-weight: 600;
    color: var(--c-text);
  }

  figcaption {
    margin-top: var(--sp-3);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--c-text-muted);
  }

  /* Too narrow for a row: the phases stack, each moment a stop and its name between them. */
  @container (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--sp-5);
    }

    .row > li {
      grid-row: auto;
      grid-template-rows: none;
    }

    .stop-cell {
      display: flex;
      justify-content: center;
      gap: var(--sp-3);
    }

    .moment-label {
      position: static;
    }

    .shape,
    .name,
    .notes {
      grid-row: auto;
    }

    .shape {
      width: min(100%, 360px);
      justify-self: center;
    }

    .notes {
      width: min(100%, 420px);
      justify-self: center;
    }

  }

  @media (prefers-reduced-motion: no-preference) {
    .arrive .row > li {
      opacity: 0;
      translate: 0 8px;
    }

    .arrive.seen .row > li {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity var(--motion-base) var(--ease-out) calc(var(--i) * 80ms),
        translate var(--motion-spring) var(--ease-spring) calc(var(--i) * 80ms);
    }
  }

  @media (forced-colors: active) {
    .edge,
    .split {
      stroke: CanvasText;
    }

    .open,
    .close {
      fill: Canvas;
    }
  }
</style>

<script>
  // Once, as it comes into view, the parts arrive left to right.
  const seen = new IntersectionObserver(
    (entries) => {
      entries
        .filter((e) => e.isIntersecting)
        .forEach((e) => {
          e.target.classList.add('seen');
          seen.unobserve(e.target);
        });
    },
    { threshold: 0.3 },
  );
  document.querySelectorAll('[data-diamonds].arrive').forEach((fig) => seen.observe(fig));
</script>
