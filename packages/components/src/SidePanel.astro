---
/**
 * Detail that opens beside what you were reading. A real dialog, so focus, Escape and the
 * backdrop come from the browser. Any element with data-panel-open="id" opens it; add
 * data-panel-section="id" to scroll to a section inside. From script, openPanel() in sidepanel.js
 * opens it with a title and a loading state, then what arrived or that it failed.
 */
import Button from './Button.astro';

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const titleId = `${id}-title`;
---

<dialog class="side-panel" id={id} aria-labelledby={titleId} data-side-panel>
  <div class="head">
    <h2 id={titleId}>{title}</h2>
    <Button data-panel-close>Close</Button>
  </div>
  <div class="body"><slot /></div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog[data-side-panel]').forEach((panel) => {
    panel.querySelector('[data-panel-close]')?.addEventListener('click', () => panel.close());
    // A click on the backdrop lands on the dialog itself.
    panel.addEventListener('click', (e) => {
      if (e.target === panel) panel.close();
    });
    document.querySelectorAll<HTMLElement>(`[data-panel-open="${panel.id}"]`).forEach((trigger) => {
      trigger.addEventListener('click', () => {
        panel.showModal();
        const section = trigger.dataset.panelSection;
        if (section) document.getElementById(section)?.scrollIntoView({ block: 'start' });
        else panel.scrollTop = 0;
      });
    });
  });
</script>

<style>
  /* openPanel's states: a quiet loading shape, then what arrived settling in, or what failed. */
  .side-panel :global(.panel-loading) {
    display: grid;
    gap: var(--sp-3);
  }

  .side-panel :global(.panel-loading span) {
    display: block;
    height: 14px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--c-text) 7%, transparent);
  }

  .side-panel :global(.panel-loading span:nth-child(2)) {
    width: 70%;
  }

  .side-panel :global(.panel-loading span:nth-child(3)) {
    width: 85%;
  }

  .side-panel :global(.panel-failed p) {
    margin: 0 0 var(--sp-3);
    color: var(--c-text-secondary);
  }

  .side-panel :global(.panel-failed button) {
    min-height: 40px;
    padding: 0 var(--sp-4);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-sm);
    background: var(--c-surface);
    color: var(--c-text);
    font: inherit;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .side-panel :global(.panel-loading span) {
      animation: panel-wait 1.2s var(--ease-standard) infinite;
    }

    .side-panel :global(.panel-arrived) {
      animation: panel-in var(--motion-slow, 260ms) var(--ease-out) both;
    }
  }

  @keyframes panel-wait {
    50% {
      opacity: 0.45;
    }
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .side-panel {
    margin: 0 0 0 auto;
    width: min(900px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0 var(--sp-5) var(--sp-6);
    border: 0;
    border-inline-start: 1px solid var(--c-border);
    background: var(--c-bg);
    color: var(--c-text);
    overflow-y: auto;
    /* Scrolling past the end stays here, instead of moving the page behind it. */
    overscroll-behavior: contain;
    /* It leaves but stays within reach, so it uses standard easing, and leaves quicker. */
    opacity: 0;
    transform: translateX(16px);
    transition:
      opacity var(--motion-base) var(--ease-standard),
      transform var(--motion-base) var(--ease-standard),
      overlay var(--motion-base) allow-discrete,
      display var(--motion-base) allow-discrete;
  }

  /* It arrives on the spring, so it settles instead of stopping. Tokens before 0.3.0 have no
     spring, and it falls back to ease-out. */
  .side-panel[open] {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--motion-slow) var(--ease-out),
      transform var(--motion-spring, var(--motion-slow)) var(--ease-spring, var(--ease-out)),
      overlay var(--motion-spring, var(--motion-slow)) allow-discrete,
      display var(--motion-spring, var(--motion-slow)) allow-discrete;
  }

  @starting-style {
    .side-panel[open] {
      opacity: 0;
      transform: translateX(24px);
    }
  }

  .side-panel::backdrop {
    background: rgb(0 0 0 / 0);
    transition:
      background-color var(--motion-base) var(--ease-standard),
      overlay var(--motion-base) allow-discrete,
      display var(--motion-base) allow-discrete;
  }

  .side-panel[open]::backdrop {
    background: rgb(0 0 0 / 0.4);
    transition-duration: var(--motion-slow);
    transition-timing-function: var(--ease-out);
  }

  @starting-style {
    .side-panel[open]::backdrop {
      background: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .side-panel,
    .side-panel[open] {
      transform: none;
    }

    @starting-style {
      .side-panel[open] {
        transform: none;
      }
    }
  }

  .head {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    padding-block: var(--sp-4);
    background: var(--c-bg);
  }

  /* A section opened from a link clears the head. */
  .body :global([id]) {
    scroll-margin-top: 72px;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
  }
</style>
