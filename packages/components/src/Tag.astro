---
/**
 * A pill: optional icon, then a label. Used for tags and links, so both read as
 * the same object.
 *
 * The fills are meaningful rather than decorative:
 *   accent  → this is a link you can act on, or a live state
 *   quiet   → this is a descriptor, not something to click
 *   warm    → a warm tag: how something was done
 *   cool    → the cool tag: what something was about
 *
 * A linked tag lifts 2px under a real pointer and gives under a press, and the spring brings it
 * back. `still` turns that off, for a tag inside something that moves as a whole (CopyTag).
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon?: IconName;
  href?: string;
  tone?: 'accent' | 'quiet' | 'warm' | 'cool' | 'good';
  small?: boolean;
  /** No lift or press, for a linked tag inside something that moves as a whole. */
  still?: boolean;
}

const { icon, href, tone = 'quiet', small = false, still = false } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['tag', tone, { small, still }]} href={href}>
  {icon && <Icon name={icon} size={15} />}
  <slot />
</Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 5px var(--sp-3) 5px var(--sp-2);
    border-radius: var(--radius-full);
    font-size: var(--text-body-sm);
    line-height: 1.4;
    border: 1px solid transparent;
    text-decoration: none;
    white-space: nowrap;
  }

  /* No icon means no need for the tighter left padding. */
  .tag:not(:has(svg)) {
    padding-inline: var(--sp-3);
  }

  .quiet {
    background: var(--c-surface);
    border-color: var(--c-border);
    color: var(--c-text-muted);
  }

  .accent,
  .warm {
    background: var(--c-surface-tint);
    color: var(--c-text-accent);
  }

  .cool {
    background: var(--c-tag-cool-bg);
    color: var(--c-tag-cool-text);
  }

  /* Something in its favour: the page decides what (nearby, remote), the tag only says good. */
  .good {
    background: color-mix(in oklab, var(--c-status-good) 16%, var(--c-surface));
    color: var(--c-text);
  }

  .tag.small {
    padding-block: 2px;
    font-size: var(--text-caption);
  }

  a.tag {
    transition:
      border-color var(--motion-hover) var(--ease-hover),
      background-color var(--motion-hover) var(--ease-hover),
      translate var(--motion-spring) var(--ease-spring),
      scale var(--motion-base) var(--ease-out);
  }

  @media (hover: hover) {
    a.tag:not(.still):hover {
      translate: 0 -2px;
    }
  }

  a.tag:not(.still):active {
    scale: 0.97;
    transition-duration: var(--motion-hover), var(--motion-hover), var(--motion-spring), 80ms;
  }

  @media (prefers-reduced-motion: reduce) {
    a.tag {
      translate: none !important;
      scale: none !important;
    }
  }

  a.quiet:hover {
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  a.accent:hover {
    border-color: var(--c-accent-edge);
  }
</style>
