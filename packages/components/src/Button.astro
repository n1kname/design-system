---
/**
 * A button, or a link that looks like one. Uses the real elements, so focus, tab order,
 * Enter and Space come from the browser: never add a positive tabindex.
 *
 *   primary    the one main action in a view
 *   secondary  everything else
 *   quiet      low-emphasis actions beside content
 *   danger     an action that deletes or can't be undone
 *
 * On hover a soft light follows the pointer, and a press springs back. A trailing icon with
 * class `forward` (an arrow) steps 2px ahead on hover. All of it is off under reduced motion.
 *
 * `selected` is for a toggle, and sets aria-pressed. Pass any other attribute through,
 * such as id, type or disabled.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'quiet' | 'danger';
  href?: string;
  selected?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const { variant = 'secondary', href, selected, disabled, type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type, disabled, 'aria-pressed': selected === undefined ? undefined : String(selected) };
---

<Tag class:list={['button', variant, className]} {...attrs} {...rest}><slot /></Tag>

<script>
  // The spotlight: one listener for the page, so buttons added later get it too.
  if (!(window as any).__buttonSpot) {
    (window as any).__buttonSpot = true;
    document.addEventListener('pointermove', (e) => {
      const b = (e.target as Element)?.closest?.('.button') as HTMLElement | null;
      if (!b) return;
      const r = b.getBoundingClientRect();
      b.style.setProperty('--x', `${e.clientX - r.left}px`);
      b.style.setProperty('--y', `${e.clientY - r.top}px`);
    }, { passive: true });
  }
</script>

<style>
  .button {
    --x: 50%;
    --y: 50%;
    --spot: rgb(255 255 255 / 0.32);
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 40px;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--motion-hover) var(--ease-hover),
      border-color var(--motion-hover) var(--ease-hover),
      color var(--motion-hover) var(--ease-hover),
      transform var(--motion-fast) var(--ease-out);
  }

  /* The spotlight: a soft light under the pointer, fading in on hover. */
  .button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Rounded with the button instead of clipped by it: overflow: hidden would let a flex row squeeze the button below its label. */
    border-radius: inherit;
    opacity: 0;
    background: radial-gradient(120px circle at var(--x) var(--y), var(--spot), transparent 60%);
    transition: opacity 200ms var(--ease-out);
  }

  .button:hover:not(:disabled)::before {
    opacity: 1;
  }

  .button :global(svg.forward) {
    transition: transform 200ms var(--ease-out);
  }

  .button:hover :global(svg.forward) {
    transform: translateX(2px);
  }

  /* A fingertip needs more room than a pointer. */
  @media (pointer: coarse) {
    .button {
      min-height: 44px;
    }
  }

  .primary {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .primary:hover {
    background: var(--c-accent-hover);
  }

  .secondary {
    --spot: color-mix(in oklab, var(--c-accent) 16%, transparent);
    background: var(--c-surface);
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  .secondary:hover {
    border-color: var(--c-accent-edge);
    color: var(--c-text-accent);
  }

  .quiet {
    --spot: var(--c-surface-hover);
    background: transparent;
    color: var(--c-text-secondary);
  }

  .quiet:hover {
    background: var(--c-surface-hover);
    color: var(--c-text);
  }

  /* The page's background colour as text: light on the light theme's deep red, dark on the dark
   * theme's brighter red; both pass 4.5:1. */
  .danger {
    background: var(--c-status-critical);
    color: var(--c-bg);
  }

  .danger:hover {
    background: color-mix(in oklab, var(--c-status-critical) 88%, var(--c-text));
  }

  .button[aria-pressed='true'] {
    background: var(--c-surface-tint);
    border-color: var(--c-accent-edge);
    color: var(--c-text-accent);
  }

  .button:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  /* The press springs back. */
  .button:active:not(:disabled) {
    transform: scale(0.96);
    transition: transform var(--motion-spring) var(--ease-spring);
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .button:active:not(:disabled),
    .button:hover :global(svg.forward) {
      transform: none;
    }

    .button::before,
    .button :global(svg.forward) {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .button {
      border-color: ButtonText;
    }
  }
</style>
