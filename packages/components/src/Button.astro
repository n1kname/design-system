---
/**
 * A button, or a link that looks like one. Uses the real elements, so focus, tab order,
 * Enter and Space come from the browser: never add a positive tabindex.
 *
 *   primary    the one main action in a view
 *   secondary  everything else
 *   quiet      low-emphasis actions beside content
 *
 * `selected` is for a toggle, and sets aria-pressed. Pass any other attribute through,
 * such as id, type or disabled.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'quiet';
  href?: string;
  selected?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const { variant = 'secondary', href, selected, disabled, type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = href ? { href } : { type, disabled, 'aria-pressed': selected === undefined ? undefined : String(selected) };
---

<Tag class:list={['button', variant, className]} {...attrs} {...rest}><slot /></Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: 40px;
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  /* A fingertip needs more room than a pointer. */
  @media (pointer: coarse) {
    .button {
      min-height: 44px;
    }
  }

  .primary {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .primary:hover {
    background: var(--c-accent-hover);
  }

  .secondary {
    background: var(--c-surface);
    border-color: var(--c-border-strong);
    color: var(--c-text);
  }

  .secondary:hover {
    border-color: var(--c-accent-edge);
    color: var(--c-text-accent);
  }

  .quiet {
    background: transparent;
    color: var(--c-text-secondary);
  }

  .quiet:hover {
    background: var(--c-surface-tint);
    color: var(--c-text);
  }

  .button[aria-pressed='true'] {
    background: var(--c-surface-tint);
    border-color: var(--c-accent-edge);
    color: var(--c-text-accent);
  }

  .button:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .button:active:not(:disabled) {
    transform: scale(0.97);
  }

  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (prefers-reduced-motion: reduce) {
    .button:active:not(:disabled) {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .button {
      border-color: ButtonText;
    }
  }
</style>
