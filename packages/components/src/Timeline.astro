---
/**
 * A timeline: a marker and a line down the left, and each entry's period, title and text beside
 * it. The period sits above the title, small, so a year, a phase or a name all read the same, and
 * the text keeps the width.
 *
 * Entries up to `current` are done (filled markers on a solid line); `current` is now (a marker
 * with a halo); any after it are still to come (hollow markers on a dashed line). By default the
 * last entry is now. `order="newest-first"` turns that round for a history read from today back,
 * such as a career: the first entry is now and the ones below it are done. An entry can carry an
 * icon, shown in a disc: soft for what's done, the accent with a halo for now. With `fill` the discs
 * are the same, in teal for the history behind and the accent for now.
 *
 * Once, as each entry comes into view, its marker settles in, its text rises and its line draws on
 * to the next. Nothing moves under reduced motion, and without script everything is simply there.
 *
 * `fill` is the other motion, for a long history that is read rather than glanced at: the same
 * gapped, rounded segments, each filling as the reading line (60% down the window) passes it, in
 * the accent for the step into now and the chart teal for the rest. Each marker it reaches lights
 * up in full teal. The entries
 * don't arrive: the fill is the one moment. Under reduced motion, or without script, the rail is
 * drawn in full.
 *
 * Each entry takes richer content than `body` through a slot named after its place, `entry-0`,
 * `entry-1` and so on: a story in paragraphs, or tags. It goes after the text.
 */
import type { IconName } from './icons';
import Icon from './Icon.astro';

interface Entry {
  period: string;
  label: string;
  /** A line under the title, such as the role held. */
  meta?: string;
  body?: string;
  /** What the step was, from the icon set: users, search, route, … */
  icon?: IconName;
}

interface Props {
  entries: Entry[];
  /** Which entry is now, 0 first. The last by default, the first for newest-first; false for a history that is over. */
  current?: number | false;
  /** How the entries run down the page. */
  order?: 'oldest-first' | 'newest-first';
  /** The rail fills as the reader scrolls down it. */
  fill?: boolean;
  /** Sets each title as a heading at this level, for a timeline that is a section's main content. */
  heading?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const { entries, order = 'oldest-first', fill = false, heading, class: className } = Astro.props;
const newest = order === 'newest-first';
const current = Astro.props.current === undefined ? (newest ? 0 : entries.length - 1) : Astro.props.current;
const icons = entries.some((e) => e.icon);
const state = (i: number) => {
  if (current === false) return 'done';
  if (i === current) return 'current';
  return (newest ? i > current : i < current) ? 'done' : 'next';
};
// The line below an entry is dashed when it runs between now and what is still to come.
const dashed = (i: number) => (newest ? state(i) === 'next' : state(i + 1) === 'next');
const Title = heading ?? 'p';
const extras = await Promise.all(
  entries.map((_, i) => (Astro.slots.has(`entry-${i}`) ? Astro.slots.render(`entry-${i}`) : Promise.resolve(''))),
);
---

<ol
  class:list={['timeline', className]}
  data-icons={icons ? '' : undefined}
  data-fill={fill ? '' : undefined}
  data-order={order}
  data-current={current === false ? undefined : current}
  data-timeline
>
  {
    entries.map((e, i) => (
      <li data-state={state(i)} aria-current={state(i) === 'current' ? 'step' : undefined} data-to={i < entries.length - 1 ? (dashed(i) ? 'next' : 'done') : undefined}>
        <span class="marker" aria-hidden="true">
          {e.icon && <Icon name={e.icon} size={16} />}
        </span>
        <div class="content">
          <p class="period">{e.period}</p>
          <Title class="label">{e.label}</Title>
          {e.meta && <p class="meta">{e.meta}</p>}
          {e.body && <p class="text">{e.body}</p>}
          {extras[i] && <div class="more"><Fragment set:html={extras[i]} /></div>}
        </div>
      </li>
    ))
  }
</ol>
<script is:inline>
  // Before the first paint, so entries waiting to arrive never show and then vanish.
  (function (list) {
    if (!list || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (list.hasAttribute('data-fill')) list.classList.add('filling');
    else if ('IntersectionObserver' in window) list.classList.add('arrive');
  })(document.currentScript && document.currentScript.previousElementSibling);
</script>

<script>
  // Each entry arrives once, as it comes into view. Entries that come into view together follow
  // one another a beat apart.
  document.querySelectorAll<HTMLElement>('[data-timeline].arrive').forEach((list) => {
    const seen = new IntersectionObserver(
      (entries) => {
        entries
          .filter((e) => e.isIntersecting)
          .forEach((e, k) => {
            const li = e.target as HTMLElement;
            li.style.setProperty('--d', `${k * 110}ms`);
            li.classList.add('in');
            seen.unobserve(li);
          });
      },
      { threshold: 0.25, rootMargin: '0px 0px -8% 0px' },
    );
    list.querySelectorAll('li').forEach((li) => seen.observe(li));
  });

  // The fill: each segment, from below one marker to above the next, fills as the line being read
  // (60% down the window) passes it, and a marker counts as reached once the line is level with it.
  document.querySelectorAll<HTMLElement>('[data-timeline].filling').forEach((list) => {
    const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
    if (items.length < 2) return;
    const GAP = 6;
    let queued = false;
    const draw = () => {
      queued = false;
      const line = innerHeight * 0.6;
      const marks = items.map((li) => li.querySelector('.marker')!.getBoundingClientRect());
      items.forEach((li, i) => {
        const m = marks[i];
        li.classList.toggle('reached', m.top + m.height / 2 <= line + 1);
        const next = marks[i + 1];
        if (!next) return;
        const top = m.bottom + GAP;
        const bottom = next.top - GAP;
        const p = Math.min(1, Math.max(0, (line - top) / Math.max(1, bottom - top)));
        li.style.setProperty('--p', p.toFixed(3));
      });
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(draw);
      }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    document.fonts?.ready.then(queue);
    queue();
  });
</script>

<style>
  .timeline {
    /* The marker's size and how far it sits down the first line, so the line can meet it. */
    --m: 12px;
    --mt: 4px;
    --col: 16px;
    --gap: var(--sp-6);
    --done: var(--c-accent);
    --rail-done: color-mix(in oklab, var(--c-accent) 45%, var(--c-border));
    --rail-next: var(--c-border-strong);
    list-style: none;
    margin: var(--sp-5) 0 var(--sp-7);
    padding: 0;
  }

  .timeline[data-icons] {
    --m: 32px;
    --mt: 0px;
    --col: 32px;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: var(--col) minmax(0, 1fr);
    column-gap: var(--sp-4);
    padding-bottom: var(--gap);
  }

  li:last-child {
    padding-bottom: 0;
  }

  /* The line from this marker to the next, a small gap clear of each. */
  li:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-inline-start: calc(var(--col) / 2 - 1px);
    top: calc(var(--mt) + var(--m) + 6px);
    bottom: calc(6px - var(--mt));
    width: 2px;
    border-radius: 1px;
    background: var(--rail-done);
    transform-origin: top;
  }

  /* On to what's still to come: dashed, and quieter. */
  li[data-to='next']::before {
    background: repeating-linear-gradient(to bottom, var(--rail-next) 0 4px, transparent 4px 9px);
    opacity: 0.7;
  }

  /* ── Markers ─────────────────────────────────────────────────────────────── */
  .marker {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--m);
    height: var(--m);
    margin-top: var(--mt);
    justify-self: center;
    border-radius: var(--radius-full);
    background: var(--done);
    color: var(--c-text-accent);
  }

  .marker :global(svg) {
    display: block;
  }

  /* Now: a halo round it, so it reads as where things stand. */
  [data-state='current'] .marker {
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--c-accent) 28%, transparent);
  }

  /* Still to come: hollow. */
  [data-state='next'] .marker {
    background: var(--c-bg);
    box-shadow: inset 0 0 0 2px var(--c-border-strong);
  }

  /* With icons: a soft disc of the accent for what's done, the accent itself for now. */
  [data-icons] [data-state='done'] .marker {
    background: color-mix(in oklab, var(--c-accent) 16%, var(--c-surface));
  }

  [data-icons] [data-state='current'] .marker {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  [data-icons] [data-state='next'] .marker {
    color: var(--c-text-muted);
    box-shadow: inset 0 0 0 1.5px var(--c-border-strong);
  }

  /* ── Text ────────────────────────────────────────────────────────────────── */
  .content {
    min-width: 0;
  }

  /* With icons, the period sits level with the middle of the disc. */
  [data-icons] .content {
    padding-top: calc((var(--m) - var(--text-caption) * 1.5) / 2);
  }

  .content p {
    max-width: none;
    margin: 0;
  }

  .period {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--c-text-muted);
  }

  [data-state='current'] .period {
    color: var(--c-text-accent);
  }

  .label {
    margin-top: 2px;
    font-family: var(--font-body);
    font-size: var(--text-sub);
    line-height: var(--leading-sub);
    letter-spacing: var(--tracking-sub);
    font-weight: 600;
    color: var(--c-text);
  }

  /* As a heading: the title of a section's main content, in the display face. */
  :is(h2, h3, h4).label {
    margin-top: var(--sp-2);
    font-family: var(--font-display, var(--font-body));
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    letter-spacing: var(--tracking-h3);
  }

  .meta {
    margin-top: 2px;
    font-weight: 600;
    color: var(--c-text-secondary);
  }

  .more {
    margin-top: var(--sp-3);
  }

  .text {
    margin-top: var(--sp-1);
    color: var(--c-text-secondary);
    text-wrap: pretty;
  }

  [data-state='next'] .text {
    color: var(--c-text-muted);
  }

  /* ── Arriving, once ─────────────────────────────────────────────────────────
     Only on a page whose script has run and that allows motion, so the timeline is never hidden
     without it. The marker settles on the spring, the text rises a little, then the line draws on
     to the next entry. Now's halo ripples out once. */
  .arrive li:not(.in) .marker {
    opacity: 0;
    transform: scale(0.4);
  }

  .arrive li:not(.in) .content {
    opacity: 0;
    transform: translateY(6px);
  }

  .arrive li:not(.in)::before {
    transform: scaleY(0);
  }

  /* The transitions belong to arriving only: going back to waiting is instant. */
  .arrive li.in .marker {
    transition:
      opacity var(--motion-base) var(--ease-out) var(--d, 0ms),
      transform var(--motion-spring) var(--ease-spring) var(--d, 0ms);
  }

  .arrive li.in .content {
    transition:
      opacity var(--motion-gentle) var(--ease-out) calc(var(--d, 0ms) + 60ms),
      transform var(--motion-gentle) var(--ease-out) calc(var(--d, 0ms) + 60ms);
  }

  .arrive li.in::before {
    transition: transform calc(var(--motion-grow, 700ms) * 0.75) var(--ease-soft) calc(var(--d, 0ms) + 200ms);
  }

  .arrive [data-state='current'].in .marker::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 2px var(--c-accent);
    opacity: 0;
    animation: ripple var(--motion-reveal) var(--ease-out) calc(var(--d, 0ms) + 260ms);
  }

  @keyframes ripple {
    from {
      opacity: 0.6;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(2);
    }
  }

  /* ── Fill ───────────────────────────────────────────────────────────────────
     The same line as without the fill: a segment between each pair of markers, a small gap clear
     of each and rounded at both ends. Each segment fills from the top as the reading line passes
     it (--p, from 0 to 1, set by the script), teal for the history and the accent for the step into
     now. A marker turns full teal as the fill reaches it, with a small spring. Without the script
     (or with reduced motion) nothing is held back: every segment and marker is drawn in full. */
  [data-fill] {
    --m: 12px;
    --mt: 6px;
    --col: 24px;
    --gap: var(--sp-8);
    --rail: var(--c-chart-2);
    --rail-faint: color-mix(in oklab, var(--c-chart-2) 22%, transparent);
  }

  /* With icons, the same discs as without the fill. */
  [data-fill][data-icons] {
    --m: 32px;
    --mt: 0px;
    --col: 32px;
  }

  [data-fill] li {
    column-gap: var(--sp-5);
    --seg: var(--rail);
    --seg-faint: var(--rail-faint);
  }

  /* The step into now is the accent, before the fill reaches it as well as after. */
  [data-fill][data-order='newest-first'] li[data-state='current'],
  [data-fill][data-order='oldest-first'] li:has(+ li[data-state='current']) {
    --seg: var(--c-accent);
    --seg-faint: color-mix(in oklab, var(--c-accent) 28%, transparent);
  }

  [data-fill] li:not(:last-child)::before {
    background: var(--seg);
    opacity: 1;
  }

  [data-fill].filling li:not(:last-child)::before {
    background: linear-gradient(to bottom,
        var(--seg) 0 calc(var(--p, 0) * 100%),
        var(--seg-faint) calc(var(--p, 0) * 100%));
  }

  [data-fill] .marker {
    z-index: 1;
    background: var(--rail);
    color: var(--c-bg);
    transition:
      background-color var(--motion-base) var(--ease-out),
      color var(--motion-base) var(--ease-out);
  }

  [data-fill].filling li:not(.reached) .marker {
    background: color-mix(in oklab, var(--c-chart-2) 40%, var(--c-bg));
  }

  [data-fill] [data-state='current'] .marker {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  /* With icons: a disc the fill has reached is full teal; one it has yet to reach is a quiet tint;
     now is the accent itself, with its halo. */
  [data-fill][data-icons] [data-state] .marker {
    background: var(--rail);
    color: var(--c-bg);
  }

  [data-fill][data-icons].filling li:not(.reached) .marker {
    background: color-mix(in oklab, var(--rail) 16%, var(--c-bg));
    color: color-mix(in oklab, var(--c-chart-2) 60%, var(--c-bg));
  }

  [data-fill][data-icons] [data-state='current'] .marker,
  [data-fill][data-icons].filling [data-state='current']:not(.reached) .marker {
    background: var(--c-accent);
    color: var(--c-on-accent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--c-accent) 28%, var(--c-bg));
  }

  /* Lighting up: the marker swells a little and settles, on the spring. */
  @media (prefers-reduced-motion: no-preference) {
    [data-fill].filling li.reached .marker {
      animation: marker-lit var(--motion-spring, 340ms) var(--ease-spring, ease-out);
    }
  }

  @keyframes marker-lit {
    from { transform: scale(0.82); }
  }

  @media (max-width: 560px) {
    [data-fill] {
      --col: 18px;
      --gap: var(--sp-7);
    }

    [data-fill] li {
      column-gap: var(--sp-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-fill] .marker {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .marker {
      forced-color-adjust: none;
      background: CanvasText;
      color: Canvas;
    }

    [data-state='next'] .marker {
      background: Canvas;
      box-shadow: inset 0 0 0 2px CanvasText;
    }

    li:not(:last-child)::before {
      background: CanvasText;
    }
  }
</style>
