---
/**
 * A product screenshot on a sunken plate, with a caption. For long reads such as case studies:
 * the plate gives a light-UI capture a frame of its own, so it doesn't float on the page.
 *
 * An imported image goes through astro:assets: it is drawn at most `maxWidth` wide and served at
 * that width and twice it for sharp screens, never upscaled past what the source holds. An SVG or
 * a plain URL is used as it is.
 *
 * Leave `image` off and a labelled placeholder holds the place at the shot's size, so a page can
 * be written and reviewed before the screenshots exist, and a missing picture is visibly missing
 * rather than a broken icon. `alt` still describes the intended shot: it becomes the placeholder's
 * brief, so writing it is never wasted work.
 *
 * `lightPlate` keeps the light plate in dark mode, for transparent artwork with dark labels.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** The screenshot: an imported image or a URL. Leave off for a placeholder. */
  image?: ImageMetadata | string;
  /** What the shot shows, for a screen reader, and on the placeholder. */
  alt: string;
  caption?: string;
  /** Widest the shot is drawn, in px. Keep it well under the source's width. */
  maxWidth?: number;
  /** The placeholder's size. An image reports its own. */
  width?: number;
  height?: number;
  /** Keep the light plate in dark mode, for transparent artwork with dark labels. */
  lightPlate?: boolean;
  /** The placeholder's label. */
  placeholder?: string;
  class?: string;
}

const {
  image,
  alt,
  caption,
  maxWidth = 680,
  width = 1600,
  height = 1000,
  lightPlate = false,
  placeholder = 'Screenshot to add',
  class: className,
} = Astro.props;

const asset = image && typeof image !== 'string' && image.format !== 'svg' ? image : undefined;
const url = typeof image === 'string' ? image : image && !asset ? image.src : undefined;

// The cap and its 2x for sharp screens, never past what the source holds.
const widths = asset ? [...new Set([maxWidth, maxWidth * 2].filter((w) => w <= asset.width))] : [];
if (asset && widths.length === 0) widths.push(asset.width);
---

<figure class:list={['screenshot', className]}>
  <div class:list={['plate', { 'light-plate': lightPlate }]}>
    {
      asset ? (
        <Image
          src={asset}
          alt={alt}
          widths={widths}
          sizes={`(max-width: ${maxWidth}px) 100vw, ${maxWidth}px`}
          format="webp"
          quality={80}
          loading="lazy"
          style={`max-width: ${maxWidth}px`}
        />
      ) : url ? (
        <img src={url} alt={alt} loading="lazy" style={`max-width: ${maxWidth}px`} />
      ) : (
        <div class="placeholder" role="img" aria-label={`Placeholder. ${alt}`} style={`max-width: ${maxWidth}px; aspect-ratio: ${width} / ${height}`}>
          <span class="label">{placeholder}</span>
          <span class="spec">
            {width} × {height}
          </span>
          <span class="brief">{alt}</span>
        </div>
      )
    }
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin-block: var(--sp-6) var(--sp-7);
  }

  .plate {
    display: flex;
    justify-content: center;
    padding: var(--sp-6);
    background: var(--c-surface-sunken);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  /* Screenshots are light-UI captures: kept as they are in dark mode, not inverted or dimmed. */
  img {
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
  }

  /* The light theme's --c-surface-sunken and --c-border, fixed, so the plate is the same in both
   * themes. */
  .light-plate {
    background: #fcf1ec;
  }
  .light-plate img {
    border-color: #f1dacf;
  }

  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-2);
    width: 100%;
    padding: var(--sp-6);
    text-align: center;
    background: var(--c-surface);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-sm);
  }

  .label {
    font-family: var(--font-body);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--c-text);
  }

  .spec {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--c-text-muted);
  }

  /* The brief is the alt text, capped to a readable measure. */
  .brief {
    max-width: 46ch;
    margin-top: var(--sp-2);
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--c-text-muted);
  }

  figcaption {
    max-width: var(--layout-measure);
    margin-top: var(--sp-4);
    font-size: var(--text-body-sm);
    color: var(--c-text-muted);
  }

  @media (max-width: 640px) {
    .plate {
      padding: var(--sp-4);
    }
  }
</style>
