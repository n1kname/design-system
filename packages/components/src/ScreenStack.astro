---
/**
 * Two or three screens overlapping on a tinted panel: a case cover, or the same picture small on
 * an index card. Built in code rather than flattened into one image, so each screen stays sharp,
 * goes through astro:assets, and can move on its own.
 *
 * The first screen sits in front, low and left; the others step up and right behind it.
 *
 * Motion, all of it off under reduced motion:
 * - The screens play in once, front first, rising a little as they fade in; layers play in back
 *   to front. This is the page's entrance: no picture morphs in from the page before.
 * - A layer with `float` bobs slowly on its own, down and back, whatever the others do.
 * - `size="cover"`: under a real pointer, the screens follow it a few pixels, the front one most,
 *   so the stack reads as layers. Leaves no listener behind when there is no fine pointer.
 * - `size="card"`: when the link around it is hovered or focused (a LinkCard), the screens fan
 *   out a little, as if the stack were picked up.
 *
 * `device="phone"` lays tall phone screens side by side instead, stepping up and right, each in a
 * thin dark bezel with rounded corners. Give it the screen alone, without a device frame.
 *
 * `layers` places separate pictures on a stage instead, such as an isometric page and a card cut
 * out of it, each with a `depth`: deeper layers follow the pointer further and lift on hover, so the
 * card floats off its page. `ink="dark"` darkens the note for a light tone.
 *
 * A picture is an imported image (it goes through astro:assets, sized and converted to webp) or a
 * plain URL. `note` labels the panel, such as "Concepts, made-up data", for screens that are not
 * shipped work: keep it short on a card.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { patternStyle, type Pattern } from './patterns';

interface Screen {
  image: ImageMetadata | string;
  alt: string;
  /** A plain URL's own size in px, so the space is kept while it loads. An import knows its own. */
  size?: { width: number; height: number };
}

interface Layer {
  image: ImageMetadata | string;
  /** Position and width on the stage, in percent of its width (x, width) and height (y). */
  x: number;
  y: number;
  width: number;
  /** 0 stays put; 1 follows the pointer and lifts the most. */
  depth?: number;
  /** Bobs slowly on its own, down and back, so a card cut out of a page floats above it. */
  float?: boolean;
  alt?: string;
  /** A plain URL's own size in px, so the space is kept while it loads. An import knows its own. */
  size?: { width: number; height: number };
}

interface Props {
  /** Two or three; any more are left out. The first sits in front. */
  screens?: Screen[];
  /** Separate pictures on a stage, in place of screens. */
  layers?: Layer[];
  /** The stage's width over its height. */
  stage?: number;
  /** Dark ink on the note, for a light tone. */
  ink?: 'light' | 'dark';
  /** The panel's texture: dots (default), grid, lines, plus, waves or none. */
  pattern?: Pattern;
  /** Fade the pattern out toward the bottom left, so it reads as texture. On by default. */
  patternFade?: boolean;
  /** The panel colour: a CSS colour, deep enough for white text, such as a client's brand blue. */
  tone?: string;
  note?: string;
  /** `cover` is a 20:9 header band; `card` a 16:9 picture for a LinkCard's media slot. */
  size?: 'cover' | 'card';
  /** `laptop` for wide screens (the default), `phone` for tall ones. */
  device?: 'laptop' | 'phone';
  /** A view-transition-name, so a card's stack can grow into the cover on the page it opens. */
  transition?: string;
  /** Load the front screen first, for a cover above the fold. */
  eager?: boolean;
  /** Follow the pointer. On by default for a cover; a card fans out on hover instead. */
  parallax?: boolean;
  class?: string;
}

const { screens = [], layers = [], stage = 4 / 3, ink = 'light', pattern = 'dots', patternFade = true, tone = 'var(--c-accent)', note, size = 'cover', device = 'laptop', transition, eager = size === 'cover', parallax = size === 'cover', class: className } = Astro.props;
const shots = screens.slice(0, 3);
// Back to front, so the first screen paints last and sits on top.
const order = [...shots.keys()].reverse();
const phone = device === 'phone';
const widths = phone ? (size === 'cover' ? [240, 480, 720] : [160, 320]) : size === 'cover' ? [480, 900, 1400] : [400, 800];
const sizes = phone
  ? size === 'cover' ? '(max-width: 640px) 30vw, 230px' : '(max-width: 640px) 22vw, 70px'
  : size === 'cover' ? '(max-width: 900px) 80vw, 760px' : '(max-width: 640px) 70vw, 220px';
const layerWidths = (img: ImageMetadata) => {
  const w = [400, 800, 1200, 1600, 2400].filter((x) => x <= img.width);
  return w.length ? w : [img.width];
};
// A layer is shown at its share of the stage: on a cover about 56% of a panel up to some 1240px wide
// (76% on a phone), on a card about the card's width. Saying so lets a small card load a small file.
const layerSizes = (width: number) =>
  size === 'cover'
    ? `(max-width: 640px) ${Math.round(width * 0.7)}vw, ${Math.round(width * 7)}px`
    : `(max-width: 640px) ${Math.round(width * 0.9)}vw, ${Math.round(width * 3.6)}px`;
const fit = (img: ImageMetadata) => [...new Set(widths.filter((w) => w <= img.width))];
---

<div
  class:list={['screen-stack', size, device, `n${shots.length}`, `ink-${ink}`, { 'has-layers': layers.length, 'pattern-fade': patternFade }, className]}
  style={`--stack-tone: ${tone}; ${patternStyle(pattern, ink)}${transition ? ` view-transition-name: ${transition}; view-transition-class: media;` : ''}`}
  data-screen-stack-parallax={parallax ? '' : undefined}
>
  {note && <p class="note">{note}</p>}
  {
    layers.length > 0 && (
      <div class="stage" style={`aspect-ratio: ${stage}`}>
        {layers.map((l, i) => (
          <div class:list={['layer', { float: l.float }]} style={`left: ${l.x}%; top: ${l.y}%; width: ${l.width}%; --depth: ${l.depth ?? 0}; --i: ${i}`}>
            {typeof l.image === 'string' ? (
              <img src={l.image} alt={l.alt ?? ''} width={l.size?.width} height={l.size?.height} loading={eager ? 'eager' : 'lazy'} />
            ) : (
              <Image
                src={l.image}
                alt={l.alt ?? ''}
                widths={layerWidths(l.image)}
                sizes={layerSizes(l.width)}
                format="webp"
                quality={80}
                loading={eager ? 'eager' : 'lazy'}
              />
            )}
          </div>
        ))}
      </div>
    )
  }
  {
    layers.length > 0 ? null : order.map((i) => {
      const s = shots[i];
      const first = i === 0;
      return (
        <div class={`screen s${i}`}>
          {typeof s.image === 'string' ? (
            <img src={s.image} alt={s.alt} width={s.size?.width} height={s.size?.height} loading={eager && first ? 'eager' : 'lazy'} />
          ) : (
            <Image
              src={s.image}
              alt={s.alt}
              widths={fit(s.image).length ? fit(s.image) : [s.image.width]}
              sizes={sizes}
              format="webp"
              quality={82}
              loading={eager && first ? 'eager' : 'lazy'}
              fetchpriority={eager && first ? 'high' : 'auto'}
            />
          )}
        </div>
      );
    })
  }
</div>

<script>
  // The cover's layers follow the pointer: a fraction of the way, eased by a CSS transition, the
  // front screen most. Only where there is a fine pointer and motion is welcome.
  const fine = matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  const stacks = document.querySelectorAll<HTMLElement>('[data-screen-stack-parallax]');
  if (fine.matches) {
    for (const el of stacks) {
      let frame = 0;
      el.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--px', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
          el.style.setProperty('--py', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
        });
      });
      el.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        el.style.setProperty('--px', '0');
        el.style.setProperty('--py', '0');
      });
    }
  }
</script>

<style>
  .screen-stack {
    --px: 0;
    --py: 0;
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    aspect-ratio: 20 / 9;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        140deg,
        color-mix(in oklab, var(--stack-tone), white 12%),
        var(--stack-tone) 55%,
        color-mix(in oklab, var(--stack-tone), black 28%)
      );
  }

  /* The pattern, on a layer of its own so it can fade out toward the bottom left. */
  .screen-stack::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--pattern-image) 0 0 / var(--pattern-size);
  }
  .pattern-fade::before {
    mask-image: radial-gradient(130% 110% at 100% 0%, #000 25%, transparent 80%);
  }

  .card {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
  }

  .note {
    position: absolute;
    top: var(--sp-5);
    left: var(--sp-6);
    z-index: 4;
    margin: 0;
    padding: 4px var(--sp-3);
    border-radius: var(--radius-full);
    /* Tinted from the panel and blurred, so it reads even where a picture runs under it. */
    background: color-mix(in oklab, var(--stack-tone), black 30%);
    background: color-mix(in oklab, color-mix(in oklab, var(--stack-tone), black 35%) 72%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    font-size: var(--text-caption);
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .card .note {
    top: var(--sp-2);
    left: var(--sp-2);
    padding: 1px var(--sp-2);
    font-size: 11px;
  }

  /* Layers on a stage over the right of the panel; they carry their own shadows. */
  .stage {
    position: absolute;
    right: 4%;
    top: 6%;
    width: 56%;
  }

  .layer {
    position: absolute;
    --lift: 0px;
    transform: translate(calc(var(--px) * var(--depth) * 16px), calc(var(--py) * var(--depth) * 12px + var(--lift)));
    transition: transform var(--motion-grow, 700ms) var(--ease-soft, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .layer :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .screen-stack:hover .layer {
      --lift: calc(var(--depth) * -14px);
    }
  }

  .card .stage {
    right: -10%;
    top: -8%;
    width: 100%;
  }

  .ink-dark {
    background:
      linear-gradient(
        140deg,
        color-mix(in oklab, var(--stack-tone), white 14%),
        var(--stack-tone) 55%,
        color-mix(in oklab, var(--stack-tone), black 10%)
      );
  }
  .ink-dark .note {
    background: color-mix(in oklab, color-mix(in oklab, var(--stack-tone), white 45%) 78%, transparent);
    color: #17181a;
  }

  .screen {
    position: absolute;
    width: 58%;
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.18),
      0 24px 60px -12px rgb(0 0 0 / 0.45);
    transition: transform var(--motion-grow, 700ms) var(--ease-soft, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Front screen low and left, the others stepping up and right behind it. */
  .s0 { left: 8%;  top: 30%; z-index: 3; }
  .s1 { left: 25%; top: 18%; z-index: 2; }
  .s2 { left: 42%; top: 8%;  z-index: 1; }
  .n2 .s0 { left: 12%; }
  .n2 .s1 { left: 36%; top: 12%; }

  .card .screen {
    width: 66%;
    border-radius: 4px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.2),
      0 10px 24px -8px rgb(0 0 0 / 0.5);
  }
  .card .s0 { left: 6%;  top: 34%; }
  .card .s1 { left: 18%; top: 21%; }
  .card .s2 { left: 30%; top: 8%; }
  .card.n2 .s0 { left: 8%; top: 30%; }
  .card.n2 .s1 { left: 28%; top: 12%; }

  /* Phones: tall screens stepping up and right, in a thin bezel. */
  .phone .screen {
    width: 19%;
    border-radius: 11% / 5%;
    box-shadow:
      0 0 0 3px rgb(18 18 20),
      0 1px 2px rgb(0 0 0 / 0.2),
      0 24px 50px -10px rgb(0 0 0 / 0.5);
  }
  .phone .s0 { left: 27%; top: 14%; }
  .phone .s1 { left: 41%; top: 8%; }
  .phone .s2 { left: 55%; top: 2%; }
  .phone.n2 .s0 { left: 34%; }
  .phone.n2 .s1 { left: 48%; top: 6%; }

  /* The phones leave the left quarter free, so a note wraps there instead of running under them. */
  .cover.phone .note {
    max-width: 21%;
    border-radius: 10px;
    padding-block: var(--sp-1);
  }

  .card.phone .screen {
    width: 22%;
    box-shadow:
      0 0 0 2px rgb(18 18 20),
      0 8px 18px -6px rgb(0 0 0 / 0.5);
  }
  .card.phone .s0 { left: 23%; top: 18%; }
  .card.phone .s1 { left: 39%; top: 10%; }
  .card.phone .s2 { left: 55%; top: 2%; }

  @media (prefers-reduced-motion: no-preference) {
    /* Layers play in back to front, the way they are stacked, so a floating card lands last. */
    .layer {
      animation: stack-in var(--motion-reveal, 900ms) var(--ease-soft, cubic-bezier(0.16, 1, 0.3, 1)) both;
      animation-delay: calc(var(--i) * 140ms);
    }
    .screen {
      animation: stack-in var(--motion-reveal, 900ms) var(--ease-soft, cubic-bezier(0.16, 1, 0.3, 1)) both;
    }
    .s1 { animation-delay: 90ms; }
    .s2 { animation-delay: 180ms; }

    /* The cover's layers follow the pointer, the front one most. */
    [data-screen-stack-parallax] .s0 { transform: translate(calc(var(--px) * 10px), calc(var(--py) * 8px)); }
    [data-screen-stack-parallax] .s1 { transform: translate(calc(var(--px) * 6px), calc(var(--py) * 5px)); }
    [data-screen-stack-parallax] .s2 { transform: translate(calc(var(--px) * 3px), calc(var(--py) * 2px)); }

    /* A card's stack fans out when the link around it is hovered or focused. */
    :global(a:is(:hover, :focus-visible)) .card .s0 { transform: translate(-4%, 3%) rotate(-1deg); }
    :global(a:is(:hover, :focus-visible)) .card .s1 { transform: translate(0, -2%); }
    :global(a:is(:hover, :focus-visible)) .card .s2 { transform: translate(5%, -6%) rotate(1deg); }
  }

  @keyframes stack-in {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  /* A cover in a narrow column: taller, two screens, larger. */
  @container (max-width: 560px) {
    .cover .note {
      top: var(--sp-3);
      left: var(--sp-3);
    }
  }

  @media (max-width: 640px) {
    .cover {
      aspect-ratio: 4 / 3;
    }
    .cover.laptop .screen {
      width: 78%;
    }
    /* On a phone the note takes the top, so the pictures start under it rather than behind it. */
    .cover.laptop .s0 { left: 6%;  top: 44%; }
    .cover.laptop .s1 { left: 16%; top: 30%; }
    .cover.laptop .s2 { display: none; }

    /* Phones keep all three, larger, overlapping more. */
    .cover.phone .screen {
      width: 30%;
    }
    .cover.phone .s0 { left: 12%; top: 36%; }
    .cover.phone .s1 { left: 35%; top: 31%; }
    .cover.phone .s2 { left: 58%; top: 26%; }

    .cover .stage {
      right: -4%;
      top: 28%;
      width: 76%;
    }
    .cover.phone .note {
      max-width: calc(100% - 2 * var(--sp-3));
    }
  }

  /* A floating layer bobs on its picture, not the layer, so it adds to the pointer, the hover lift
   * and the arrival instead of replacing them. */
  @media (prefers-reduced-motion: no-preference) {
    .layer.float :global(img) {
      /* Three slow breaths, then still: anything moving on its own for more than five seconds
       * next to other content needs to stop (WCAG 2.2.2). */
      animation: layer-float var(--motion-float, 6s) ease-in-out 3;
    }
  }

  @keyframes layer-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 var(--float-range, 16px); }
  }
</style>
