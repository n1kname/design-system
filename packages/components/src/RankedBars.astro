---
/**
 * Ranked bars in plain HTML and CSS, so the labels are real text. Safari lays out
 * SVG text with the fallback font's widths and then paints the web font, so
 * right-aligned SVG labels come out uneven and run into the bars. The data stays in this
 * page's HTML. The only script is the arrival: the bars grow in once as the chart comes into
 * view, and without it they are simply there. Rows keep the order given.
 * `alt` speaks for the chart, and needs every value.
 */
import Figure from './Figure.astro';

interface Row {
  label: string;
  value: number;
  valueLabel?: string;
  /** A token, such as var(--c-chart-1). Without one, the de-emphasis tone. */
  color?: string;
}

interface Props {
  data: Row[];
  title?: string;
  alt: string;
  caption?: string;
}

const { data, title, alt, caption } = Astro.props;
const max = Math.max(...data.map((d) => d.value));
---

<Figure title={title} caption={caption}>
  <div class="ranked-bars" role="img" aria-label={alt}>
    <ul aria-hidden="true">
      {
        data.map((d) => (
          <li>
            <span class="label">{d.label}</span>
            <span class="track">
              <i style={`--share: ${d.value / max}; background: ${d.color ?? 'var(--c-chart-neutral)'}`} />
              <span class="value">{d.valueLabel ?? d.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Figure>

<script>
  import { enterAll } from '@n1kname/charts/enter';
  enterAll('.ranked-bars');
</script>

<style>
  .ranked-bars {
    min-width: 0;
  }

  ul {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-label);
    line-height: var(--leading-label);
    color: var(--c-text);
  }

  li {
    display: contents;
  }

  .label {
    padding-right: var(--sp-3);
    align-self: center;
    text-align: end;
  }

  .track {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding-block: 6px;
    border-left: 1px solid var(--c-chart-axis);
  }

  /* The room left for the value is what keeps the longest bar and its number inside. */
  i {
    display: block;
    flex: none;
    width: calc(var(--share) * (100% - 3.5rem));
    height: 22px;
    border-radius: 0 4px 4px 0;
  }

  .value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  @container (max-width: 560px) {
    ul {
      display: block;
    }

    li {
      display: block;
      margin-bottom: var(--sp-3);
    }

    .label {
      display: block;
      padding: 0 0 var(--sp-1);
      text-align: start;
    }

    .track {
      padding-block: 0;
      border-left: 0;
    }

    i {
      border-radius: 4px;
    }
  }

  @media (forced-colors: active) {
    i {
      background: CanvasText !important;
    }
  }

</style>
