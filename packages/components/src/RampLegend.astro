---
/**
 * What a colour scale means, low to high: a title, an optional note (how many), and the ramp
 * between its two ends. The heat ramp by default; pass `colors` for another, such as the
 * sequential tokens. On a map it goes in a FloatPanel; under a chart it stands alone.
 *
 * `steps` draws the colours as blocks, for a scale that is binned; the default is a smooth
 * gradient, for one that isn't. Change the note from script through its data-ramp-note element.
 */
interface Props {
  /** What the colour counts: "GPS points". */
  label: string;
  /** After the title, such as how many: "1,284 cells". */
  note?: string;
  low?: string;
  high?: string;
  /** Low to high. Any CSS colours, best tokens. */
  colors?: string[];
  steps?: boolean;
  id?: string;
  [key: string]: unknown;
}

const HEAT = [1, 2, 3, 4, 5, 6].map((i) => `var(--c-heat-${i})`);
const { label, note, low = 'Low', high = 'High', colors = HEAT, steps = false, id, class: className, ...rest } = Astro.props;
const stops = steps
  ? colors.map((c, i) => `${c} ${(i / colors.length) * 100}% ${((i + 1) / colors.length) * 100}%`).join(', ')
  : colors.join(', ');
---

<div class:list={['ramp-legend', className]} id={id} {...rest}>
  <p class="what"><strong>{label}</strong><span data-ramp-note>{note ? ` · ${note}` : ''}</span></p>
  <p class="scale">
    <span>{low}</span><span class="sr"> to </span><i aria-hidden="true" style={`--ramp: linear-gradient(to right, ${stops})`}></i><span>{high}</span>
  </p>
</div>

<style>
  .ramp-legend {
    display: grid;
    gap: var(--sp-2);
    color: var(--c-text-secondary);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  p {
    margin: 0;
  }

  strong {
    color: var(--c-text);
    font-weight: 600;
  }

  .scale {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  /* A hairline edge, so the yellow keeps its shape on a light surface. */
  i {
    flex: none;
    width: 120px;
    height: 10px;
    border-radius: 3px;
    background: var(--ramp);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c-text) 14%, transparent);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (forced-colors: active) {
    i {
      forced-color-adjust: none;
      outline: 1px solid CanvasText;
    }
  }
</style>
