---
/**
 * A chart or table with its title, actions and caption. `plate` sets it on a sunken
 * field, for long reads; `card` sets it on a surface, for dashboards.
 */
interface Props {
  title?: string;
  sub?: string;
  caption?: string;
  variant?: 'plate' | 'card';
  /** Makes the title a heading at this level, for a figure that is a section of the page. */
  level?: 2 | 3 | 4;
  id?: string;
}
const { title, sub, caption, variant = 'plate', level, id } = Astro.props;
const Title = level ? `h${level}` : 'p';
---

<figure class="figure" id={id}>
  <div class:list={['field', variant]}>
    {
      (title || Astro.slots.has('actions')) && (
        <div class="head">
          <div class="titles">
            {title && <Title class="title">{title}</Title>}
            {sub && <p class="sub">{sub}</p>}
          </div>
          <slot name="actions" />
        </div>
      )
    }
    <div class="body"><slot /></div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
    min-width: 0;
  }

  .field {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  /* The body is the container, not the field, so what's inside can respond to the room it has
     and the field can still be a subgrid (containment would stop that). */
  .body {
    container-type: inline-size;
  }

  .plate {
    background: var(--c-surface-sunken);
    padding: var(--sp-6);
  }

  .card {
    background: var(--c-surface);
    padding: var(--sp-5);
  }

  @media (max-width: 560px) {
    .plate {
      padding: var(--sp-5);
    }

    .card {
      padding: var(--sp-4);
    }
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sub);
    line-height: var(--leading-sub);
    color: var(--c-text);
  }

  .sub {
    margin: var(--sp-1) 0 0;
    max-width: 68ch;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--c-text-muted);
  }

  /* Side by side in a Grid, the cards in a row are one height and share their head's height, so
     a subtitle on two lines in one card doesn't push its chart below the others. */
  :global(.grid) > .figure {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  :global(.grid) > .figure:has(> figcaption) {
    grid-row: span 3;
  }

  :global(.grid) > .figure > .field {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
  }

  :global(.grid) > .figure .head {
    grid-row: 1;
  }

  :global(.grid) > .figure .body {
    grid-row: 2;
  }

  figcaption {
    margin-top: var(--sp-4);
    font-size: var(--text-body-sm);
    color: var(--c-text-muted);
    max-width: var(--layout-measure);
  }
</style>
